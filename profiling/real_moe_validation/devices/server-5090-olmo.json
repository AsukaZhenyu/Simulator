{
 "schema": "device-ensemble-profile-1",
 "device": "server-5090",
 "campaign": {
  "python": "~/venv/bin/python",
  "runner": "tools/run_accuracy_campaign.py",
  "root_pattern": "build/ensemble-server-5090-{date}-rep{nn}",
  "arguments": [
   "--columns", "model",
   "--heldout-index", "1",
   "--runtime-build", "~/work/runtime-linux4",
   "--model", "~/work/models/OLMoE-1B-7B-0924-Instruct-Q4_K_M.gguf"
  ]
 },
 "state": {
  "required": true,
  "device_index": 0,
  "band": {"temperature_c": [25, 88]},
  "stability": {"temperature_c": 4.0},
  "lock": {"enabled": false, "required": false, "sm_clock_mhz": 2400, "memory_clock_mhz": 10501},
  "precondition": {
   "enabled": true,
   "sample_interval_s": 2.0,
   "plateau": {"window_s": 60.0, "temperature_c": 1.5, "clock_fraction": 0.03}
  },
  "sample_interval_s": 5.0
 },
 "ensemble": {
  "repetitions": 10,
  "attempt_limit": 13,
  "state_boundary_ms": null
 }
}
