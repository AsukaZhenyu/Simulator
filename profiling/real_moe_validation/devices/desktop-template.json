{
 "schema": "device-ensemble-profile-1",
 "device": "desktop",
 "campaign": {
  "python": "REPLACE_ME/modeling/.venv/Scripts/python.exe",
  "runner": "tools/run_accuracy_campaign.py",
  "root_pattern": "build/ensemble-desktop-{date}-rep{nn}",
  "arguments": [
   "--columns", "model",
   "--heldout-index", "1",
   "--model-id", "REPLACE_ME",
   "--model", "REPLACE_ME/models/REPLACE_ME.gguf",
   "--runtime-build", "REPLACE_ME/runtime-windows-build-REPLACE_ME"
  ]
 },
 "state": {
  "required": true,
  "device_index": 0,
  "band": {"temperature_c": [25, 88]},
  "stability": {"temperature_c": 4.0},
  "lock": {"enabled": false, "required": false, "sm_clock_mhz": 2400, "memory_clock_mhz": 10501},
  "precondition": {
   "enabled": true,
   "sample_interval_s": 2.0,
   "plateau": {"window_s": 60.0, "temperature_c": 1.5, "clock_fraction": 0.03}
  },
  "sample_interval_s": 5.0
 },
 "ensemble": {
  "repetitions": 10,
  "attempt_limit": 13,
  "state_boundary_ms": null
 }
}
