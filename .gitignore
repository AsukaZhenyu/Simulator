# ==================== 参考材料（第三方代码 / 论文分析 / PDF，不入库） ====================
/reference/
/reference-analysis/
/reference-pdf/

# ==================== 顶层文档入口 ====================
/*.md
!/README.md
!/CONTRIBUTING.md
!/CHANGELOG.md
!/THIRD_PARTY_NOTICES.md

# ==================== 运行产物与本地文件（不入库） ====================
# 仿真运行产物：结果 json/csv。由 `python -m llm_infer_model regenerate` 从
# configs/ + tests/data/ 的示例测量数据重建，不需要入库。
modeling/outputs/
# 映射与搜索产物：stats/events/states/mapping。`python -m tensor_mapping
# model|search --out outputs/...` 的默认落地处，可从 examples/ 复跑重建。
mapping/outputs/
# llama.cpp 引擎导出的 pipeline KV backing file，396MB，运行时生成
modeling/llama_pipeline_kv.bin
# 本机清理记录，不是产品文档
/docs/maintenance/
# 测量原始产物留在本机，不入库；可分发的输入 trace 放 profiling/data/
/profiling/**/results/

# ==================== Python ====================
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
build-*/
dist/
.venv/
venv/
env/

# 测试 / 类型检查 / 格式化缓存
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
# 测试临时目录：个别用例必须把临时文件放在调用者所在盘（Windows 没有跨盘
# 符的相对路径），建在仓库根下、退出即删，崩溃残留也不入库。
.tmp-*/

# ==================== 编辑器 / 系统 ====================
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# ==================== 模型权重 ====================
# 多模型验证的权重不进仓库：单文件 0.4–9.5 GB，GitHub 单文件 100 MB、
# 单资产 2 GB、免费 LFS 1 GB 都放不下。清单在 profiling/multimodel/models.json，
# 字节由 profiling/multimodel/fetch_models.py 按 commit 拉取并校验 SHA-256。
*.gguf
*.gguf.part
