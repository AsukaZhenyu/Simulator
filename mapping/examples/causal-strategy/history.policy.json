{
  "format_version": "causal-policy-0.1",
  "placements": {
    "projection": "gpu",
    "attention": "gpu",
    "router": "gpu",
    "gather_rows": "gpu",
    "expert_ffn": "cpu",
    "scatter_rows": "gpu",
    "combine_rows": "gpu"
  },
  "experts": {
    "device_rule": "resident_first"
  },
  "cache": {
    "rule": "history_frequency"
  },
  "prefetch": {
    "enabled": true,
    "max_count": 1,
    "cache_budget_bytes": 128
  },
  "release": {
    "rule": "last_use"
  }
}
