{
  "schema_version": "0.2",
  "id": "m1-c-fork",
  "workload_file": "m1-fork.workload.json",
  "comment": "M1_ACCEPTANCE.md 4, default overlap row. ca is CPU-only, cb GPU-only and add CPU-only, so the CPU runs twice and the GPU once. The 6 ms optimum interleaves them and relies on D2H b sharing the PCIe slot with nothing else; switching allow_cpu_gpu_overlap off makes the same graph cost 8 ms.",
  "architecture": {
    "dram_capacity_bytes": 256,
    "vram_capacity_bytes": 256,
    "dram_runtime_reserved_bytes": 0,
    "vram_runtime_reserved_bytes": 0,
    "dram_alignment_bytes": 1,
    "vram_alignment_bytes": 1,
    "cpu_compute_slots": 1,
    "gpu_compute_slots": 1,
    "pcie_copy_slots": 1,
    "ssd_io_slots": 1
  },
  "goal": {"output_locations": {"y": "dram"}},
  "costs": {
    "source": "synthetic_fixed",
    "compute": {
      "ca": {
        "cpu": {"duration_ns": 3000000, "workspace_bytes": 0}
      },
      "cb": {
        "gpu": {"duration_ns": 4000000, "workspace_bytes": 0}
      },
      "add": {
        "cpu": {"duration_ns": 1000000, "workspace_bytes": 0}
      }
    },
    "transfer": {
      "vram_to_dram": {"b": {"duration_ns": 1000000}},
      "dram_to_ssd": {}
    }
  },
  "mapspace": {
    "allowed_devices": {"ca": ["cpu"], "cb": ["gpu"], "add": ["cpu"]},
    "allowed_transfers": {
      "vram_to_dram": ["b"],
      "dram_to_ssd": []
    },
    "allow_eviction": true,
    "allow_copy_compute_overlap": true,
    "allow_cpu_gpu_overlap": true,
    "allow_recomputation": false
  },
  "mapper": {
    "algorithm": "uniform_cost",
    "max_expanded_states": 0,
    "wall_time_limit_s": 0
  }
}
