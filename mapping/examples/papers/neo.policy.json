{
  "format_version": "causal-policy-0.2",
  "placements": {
    "projection": "gpu",
    "attention_core": "gpu",
    "attention_output": "gpu",
    "dense_ffn": "gpu"
  },
  "request_placements": {
    "r_cpu": {
      "attention_core": "cpu"
    }
