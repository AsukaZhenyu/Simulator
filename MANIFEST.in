include README.md LICENSE pyproject.toml MANIFEST.in
include CITATION.cff
include docs/CODE_LAYOUT.md docs/REPRODUCTION.md
recursive-include examples/library *.py *.md
recursive-include src/llm_simulator *.py py.typed
recursive-include mapping/tensor_mapping *.py
recursive-include modeling/llm_infer_model *.py
recursive-include profiling/llm_infer_profile *.py
include tests/test_distribution.py
prune reference
prune reference-analysis
prune reference-pdf
prune mapping/outputs
prune modeling/outputs
prune mapping/tests
prune modeling/tests
prune mapping/examples
prune modeling/configs
global-exclude __pycache__ *.py[cod] *.gguf *.safetensors *.pt *.pth *.bin
