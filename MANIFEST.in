include README.md LICENSE pyproject.toml MANIFEST.in
include CITATION.cff
include docs/LIBRARY_GUIDE.md docs/OPEN_SOURCE_AND_PREPRINT.md docs/RELEASE_0_1.md docs/DEVICE_STATE_RUNTIME.md
include docs/PERFORMANCE_BOUNDARIES.md
include docs/PERFORMANCE_BOUNDARY_REFACTOR_20261018.md docs/data/performance-boundary-refactor-20261018.json
recursive-include examples/library *.py *.md
recursive-include src/llm_simulator *.py py.typed
recursive-include src/llm_simulator/data *
